NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080/signal
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
# TURN credentials are delivered to the browser. Use short-lived credentials in production.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
# Set to relay temporarily when verifying that TURN works; use all normally.
NEXT_PUBLIC_ICE_TRANSPORT_POLICY=all
