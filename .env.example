NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080/signal
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Browser fallback used when the signaling server does not issue TURN credentials.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
NEXT_PUBLIC_ICE_TRANSPORT_POLICY=all

# Signaling server only. Configure coturn with use-auth-secret and the same secret.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
# Must be 600-86400 seconds and should exceed the 30-minute room lifetime.
TURN_CREDENTIAL_TTL_SECONDS=3600
# Set to relay only during a controlled TURN verification; use all normally.
ICE_TRANSPORT_POLICY=all
